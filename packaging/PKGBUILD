# Maintainer: mops1k <https://github.com/mops1k>
pkgname=plasma-keyboard-custom
pkgver=6.7.90
pkgrel=3
pkgdesc="Virtual keyboard for Qt based desktops (custom fork with gamepad support)"
arch=('x86_64')
url="https://github.com/mops1k/plasma-keyboard-custom"
license=('GPL-2.0-or-later')
# Built against Qt 6.9 (Arch Linux Archive snapshot 2025-07-28) to match
# SteamOS 3.8, which ships Qt 6.9.1. The binaries carry the Qt_6.9 symbol
# version and use Qt's private Gui/WaylandClient ABI, which is only valid for
# the Qt minor they were built against, so the versioned Qt deps below reject
# an install on anything older than Qt 6.9. SteamOS 3.7 and older ship Qt 6.7
# or 6.8 and are no longer supported by this package (build locally there).
# Ship a single package: without this makepkg also produces a ~9 MB
# plasma-keyboard-custom-debug package (the Arch default enables debug), which
# only duplicates the symbols in every release asset and in the pacman
# repository. The build no longer depends on the local makepkg.conf defaults.
options=('!debug')
depends=(
  'glibc'
  'kcmutils'
  'kconfig'
  'kcoreaddons'
  'kcrash'
  'kglobalaccel'
  'ki18n'
  'kirigami'
  'kirigami-addons'
  'kitemmodels'
  'libplasma'
  'libstdc++'
  'libxkbcommon'
  'qt6-base>=6.9.1'
  'qt6-declarative>=6.9.1'
  'qt6-virtualkeyboard>=6.9.1'
  'qt6-wayland>=6.9.1'
  'wayland'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'gettext'
  'ninja'
  'plasma-wayland-protocols'
  'pkgconf'
  'qt6-wayland'
  'wayland-protocols'
)
# Deliberately no conflicts/replaces/provides: this package installs only
# custom-named files so it can be installed next to the official
# plasma-keyboard package. Choose it in System Settings -> Virtual Keyboard.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -DKDE_INSTALL_LIBDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
